# venvs / package managers
.venv/
venv/
env/
.uv/
# uv.lock IS committed (GYCOP-122): CI `uv sync --frozen` needs it for a deterministic
# toolchain (ruff/mypy pinned). Do not re-ignore — a missing lock makes CI re-resolve
# to newer tool versions and breaks `ruff format --check`.

